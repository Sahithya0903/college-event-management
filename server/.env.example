# Copy this file to .env and put your MongoDB Atlas connection string after the equals sign.
MONGODB_URI=

# Use a long random value for this secret. Do not upload the real .env file.
ORGANIZER_USERNAME=organizer
ORGANIZER_PASSWORD=change-this-to-a-private-password
ORGANIZER_TOKEN_SECRET=replace-with-a-long-random-secret

# Add the deployed website URL here after hosting it, for example https://your-site.example
CLIENT_ORIGIN=
