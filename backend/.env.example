PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/event_management

# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Public URL of the app (used in certificate verification links)
BASE_URL=http://localhost:5000

# Comma-separated list of allowed browser origins. Leave empty to allow any origin (development only).
CLIENT_ORIGIN=

# Allow people to sign up as organizers themselves (admins can always change roles)
ALLOW_ORGANIZER_SIGNUP=true
